<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Task UI (Experience API)</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h1 { color: #333; }
    .task { margin: 5px 0; padding: 5px; border-bottom: 1px solid #ccc; }
    button { margin-left: 10px; }
  </style>
</head>
<body>
  <h1>Task Manager (GraphQL Experience API)</h1>

  <div>
    <input type="text" id="taskTitle" placeholder="Enter task title">
    <button onclick="addTask()">Add Task</button>
  </div>

  <h2>Tasks</h2>
  <div id="taskList"></div>

  <script>
    const API_URL = "http://localhost:8090/graphql"; // Experience API GraphQL endpoint

    async function fetchTasks() {
      const query = `
        query {
          tasks {
            id
            title
            completed
          }
        }
      `;
      const response = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query })
      });
      const result = await response.json();
      renderTasks(result.data.tasks);
    }

    async function addTask() {
      const title = document.getElementById("taskTitle").value;
      if (!title) return;

      const mutation = `
        mutation {
          addTask(title: "${title}") {
            id
            title
            completed
          }
        }
      `;
      await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: mutation })
      });
      document.getElementById("taskTitle").value = "";
      fetchTasks();
    }

    async function completeTask(id) {
      const mutation = `
        mutation {
          completeTask(id: ${id}) {
            id
            title
            completed
          }
        }
      `;
      await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: mutation })
      });
      fetchTasks();
    }

    function renderTasks(tasks) {
      const container = document.getElementById("taskList");
      container.innerHTML = "";
      tasks.forEach(task => {
        const div = document.createElement("div");
        div.className = "task";
        div.innerHTML = `
          ${task.title} - ${task.completed ? "✅ Completed" : "❌ Pending"}
          ${!task.completed ? <button onclick="completeTask(${task.id})">Complete</button> : ""}
        `;
        container.appendChild(div);
      });
    }

    // load tasks when page starts
    fetchTasks();
  </script>
</body>
</html>
