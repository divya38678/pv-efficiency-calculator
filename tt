package com.sc.faas.resource;

import com.sc.faas.dto.Task;
import com.sc.faas.service.ProcessService;
import jakarta.inject.Inject;
import jakarta.ws.rs.*;
import jakarta.ws.rs.core.MediaType;
import jakarta.ws.rs.core.Response;
import java.net.URI;
import java.util.List;

@Path("/api/tasks")
@Produces(MediaType.APPLICATION_JSON)
@Consumes(MediaType.APPLICATION_JSON)
public class ProcessResource {

    @Inject
    ProcessService processService;

    @GET
    public Response getAllTasks() {
        List<Task> tasks = processService.getAllTasks();
        return Response.ok(tasks).build();
    }

    @GET
    @Path("/{id}")
    public Response getTaskById(@PathParam("id") Long id) {
        Task task = processService.getTaskById(id);
        if (task == null) {
            return Response.status(Response.Status.NOT_FOUND)
                    .entity("{\"error\": \"Task with ID " + id + " not found\"}")
                    .build();
        }
        return Response.ok(task).build();
    }

    @POST
    public Response createTask(Task task) {
        // Basic validation (enhance with @NotBlank later if needed)
        if (task.title == null || task.title.trim().isEmpty()) {
            return Response.status(Response.Status.BAD_REQUEST)
                    .entity("{\"error\": \"Task title is required\"}")
                    .build();
        }

        Task created = processService.createTask(task.title, task.completed);
        return Response.created(URI.create("/api/tasks/" + created.id))
                .entity(created)
                .build();
    }

    @PUT
    @Path("/{id}")
    public Response updateTask(@PathParam("id") Long id, Task task) {
        if (task.title == null || task.title.trim().isEmpty()) {
            return Response.status(Response.Status.BAD_REQUEST)
                    .entity("{\"error\": \"Task title is required\"}")
                    .build();
        }

        Task updated = processService.updateTask(id, task.title, task.completed);
        if (updated == null) {
            return Response.status(Response.Status.NOT_FOUND)
                    .entity("{\"error\": \"Task with ID " + id + " not found\"}")
                    .build();
        }
        return Response.ok(updated).build();
    }

    @DELETE
    @Path("/{id}")
    public Response deleteTask(@PathParam("id") Long id) {
        boolean deleted = processService.deleteTask(id);
        if (!deleted) {
            return Response.status(Response.Status.NOT_FOUND)
                    .entity("{\"error\": \"Task with ID " + id + " not found\"}")
                    .build();
        }
        return Response.noContent().build();
    }
}

