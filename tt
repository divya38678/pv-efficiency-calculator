package com.sc.faas.service;

import com.sc.faas.dto.TaskDto;
import jakarta.enterprise.context.ApplicationScoped;
import org.eclipse.microprofile.graphql.*;

import java.util.ArrayList;
import java.util.List;

@ApplicationScoped
@GraphQLApi
public class MutationService {

    private final List<TaskDto> tasks = new ArrayList<>();
    private int counter = 3;

    public MutationService() {
        tasks.add(new TaskDto(1, "Learn Quarkus", false));
        tasks.add(new TaskDto(2, "Build Experience API", false));
    }

    @Mutation
    public TaskDto addTask(@Name("title") String title) {
        TaskDto task = new TaskDto(counter++, title, false);
        tasks.add(task);
        return task;
    }

    @Mutation
    public TaskDto completeTask(@Name("id") int id) {
        for (TaskDto task : tasks) {
            if (task.getId() == id) {
                TaskDto updated = new TaskDto(task.getId(), task.getTitle(), true);
                tasks.set(tasks.indexOf(task), updated);
                return updated;
            }
        }
        return null;
    }
}


